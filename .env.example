POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

MINIO_URL=
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=
MINIO_BUCKET_ENCRYPTION_REQUIRED=false
#MINIO_SECRET_KEY=
#MINIO_ACCESS_KEY=
# Vazio no MinIO local. Cloudflare R2: auto. AWS S3: a region do bucket.
MINIO_REGION=

JWT_SECRET=
JWT_EXPIRATION=

VITE_API_BASE_URL=
#VITE_MINIO_ENDPOINT=
#VITE_MINIO_BUCKET=

# --- EMAIL ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
APP_FRONTEND_URL=http://localhost:5173
# URL publica da propria API (usada no link de download de uso unico)
APP_API_URL=http://localhost:8080
# Origens autorizadas a chamar a API pelo browser (separadas por virgula).
# Em producao precisa conter o dominio publico do frontend.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Schema e log (defaults seguros para producao)
SPRING_JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
# Seeder de dados iniciais: use true so em ambiente local/desenvolvimento
APP_SEED_ENABLED=false
APP_SEED_ADMIN_PASSWORD=
APP_SEED_CONTRATANTE_PASSWORD=
APP_SEED_CONTRATADA_PASSWORD=

# --- CRIPTOGRAFIA DE CAMPOS SENSIVEIS (AES-256-GCM) ---
# Gerar uma chave segura com: openssl rand -base64 32
# NUNCA commitar o valor real aqui. Usar secret manager em producao.
APP_FIELD_ENCRYPTION_KEY=

# --- LGPD ---
# Versao atual do termo exibido ao usuario (ex: v1.0)
APP_LGPD_VERSAO_TERMO_ATUAL=v1.0
# SHA-256 do texto integral do termo: echo -n "TEXTO_DO_TERMO" | sha256sum
APP_LGPD_TERMO_HASH_ATUAL=
# Texto atual do termo exibido no frontend para consentimento LGPD
APP_LGPD_TERMO_TEXTO_ATUAL=

# --- PRODUCAO: MinIO KES/Vault (SSE-KMS envelope encryption) ---
# Descomentar e configurar quando provisionado em producao
#MINIO_KMS_KES_ENDPOINT=https://kes:7373
#MINIO_KMS_KES_KEY_NAME=portal-partners-master-key