# --- LGPD ---
# Versao atual do termo exibido ao usuario (ex: v1.0)
APP_LGPD_VERSAO_TERMO_ATUAL=v1.0
# SHA-256 do texto integral do termo: echo -n "TEXTO_DO_TERMO" | sha256sum
APP_LGPD_TERMO_HASH_ATUAL=
# Texto atual do termo exibido no frontend para consentimento LGPD
APP_LGPD_TERMO_TEXTO_ATUAL=

